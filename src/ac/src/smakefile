Getsym.o: Getsym.c 
	sc $(DEBUG) Getsym.c

Symbol.o: Symbol.c 
	sc $(DEBUG) Symbol.c

Builtins.o: Builtins.c 
	sc $(DEBUG) Builtins.c

Cglbdef.o: Cglbdef.c 
	sc $(DEBUG) Cglbdef.c

Getopt.o: Getopt.c 
	sc $(DEBUG) Getopt.c


# Assembler reference dump via SAS/C + omd (no link).
# Compare against bootstrap/ac and bootstrap/self from GNU make.
# Per SASC6V2:  sc … file.c ; omd >file.s file.o
bootstrap-sasc:
	-makedir bootstrap
	-makedir $(OUTDIR_SASC)
	sc $(SASCFLAGS) OBJECTNAME=Analyze.sasc.o Analyze.c
	omd >Analyze.sasc.s Analyze.sasc.o
	copy Analyze.sasc.s $(OUTDIR_SASC)/Analyze.s
	-delete Analyze.sasc.o QUIET
	-delete Analyze.sasc.s QUIET
	sc $(SASCFLAGS) OBJECTNAME=Expr.sasc.o Expr.c
